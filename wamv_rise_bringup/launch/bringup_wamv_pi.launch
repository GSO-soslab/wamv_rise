<launch>

    <arg name="robot_name" default="wamv_rise"/>

    <!-- Bring up the Pi playload  -->
    <include file="$(find wamv_rise_bringup)/launch/bringup_pi_payload.launch">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>

    <!-- Bring up the localizaion  -->
    <include file="$(find wamv_rise_bringup)/launch/bringup_localization.launch">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>

    <!-- Bring up the MVP  -->
    <include file="$(find wamv_rise_bringup)/launch/bringup_mvp.launch">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>

</launch>