<launch>

    <arg name="robot_name" default="wamv_rise"/>

    <!-- Bring roslaunch manager -->
    <include file="$(find wamv_rise_bringup)/launch/include/roslaunch_manager.launch.xml">
        <arg name="robot_name" value="$(arg robot_name)"/>
        <arg name="delay" value="0.0"/>
    </include>

</launch>