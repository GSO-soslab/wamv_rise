<launch>

    <arg name="robot_name"  
        default="changeme" />
    <arg name="delay" 
        default="1.0" />
    <arg name="port_config" 
        default="$(find wamv_rise_config)/config/torqeedo_port.yaml"/>
    <arg name="starboard_config" 
        default="$(find wamv_rise_config)/config/torqeedo_starboard.yaml"/>

    <group ns="$(arg robot_name)" >

        <node ns="torqeedo_port" pkg="torqeedo_motor" type="torqeedo_motor_node" 
                name="port_torqeedo_node" output="screen" 
                launch-prefix="bash -c 'sleep $(arg delay); $0 $@'">
                <rosparam command="load" file="$(arg port_config)"/>

                <remap from="control/speed_mode"        to="/wamv_rise/joy_mode"/>
                <remap from="control/joy_speed"        to="/wamv_rise/manual_port_thruster"/>
                <remap from="control/controller_speed" to="/wamv_rise/port_thruster"/>
        </node>

        <node ns="torqeedo_starboard" pkg="torqeedo_motor" type="torqeedo_motor_node" 
                name="starboard_torqeedo_node" output="screen" 
                launch-prefix="bash -c 'sleep $(arg delay); $0 $@'">
                <rosparam command="load" file="$(arg starboard_config)"/>

                <remap from="control/speed_mode"        to="/wamv_rise/joy_mode"/>
                <remap from="control/joy_speed"        to="/wamv_rise/manual_starboard_thruster"/>
                <remap from="control/controller_speed" to="/wamv_rise/starboard_thruster"/>
        </node>

    </group>

</launch>

