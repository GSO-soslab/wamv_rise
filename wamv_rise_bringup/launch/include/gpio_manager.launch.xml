<launch>

    <arg name="robot_name" default="changeme"/>
    <arg name="delay" default="1.0" />


    <node ns="$(arg robot_name)" name="$(arg robot_name)_gpio_manager_node" pkg="mvp_gpio_manager" 
          type="gpio_manager_node" output="screen" launch-prefix="bash -c 'sleep $(arg delay); $0 $@'">

        <rosparam command="load" file="$(find wamv_rise_config)/config/gpio_manager.yaml"/>
    </node>

</launch>