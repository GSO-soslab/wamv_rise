<launch>


    <arg name="robot_name" default="changeme"/>
    <arg name="delay" default="1.0" />

    <node ns="$(arg robot_name)" pkg="unicore_rtk_driver" type="driver_node.py"
          name="unicore_rtk_driver" output="screen" launch-prefix="bash -c 'sleep $(arg delay); $0 $@'">
          
        <rosparam command="load" file="$(find wamv_rise_config)/config/rtk_gps.yaml"/>

        <param name="gps_frame_id" value="$(arg robot_name)/unicore_gps"/>
        <param name="heading_frame_id" value="$(arg robot_name)/world_ned"/>

    </node>

</launch>

