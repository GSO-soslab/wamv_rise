<launch>


    <arg name="robot_name" default="changeme"/>
    <arg name="delay" default="1.0" />

    <node ns="$(arg robot_name)" pkg="mvp_roslaunch_manager" type="roslaunch_manager_node.py" 
          name="roslaunch_manager_node" output="screen" 
          launch-prefix="bash -c 'sleep $(arg delay); $0 $@'">

            <param name = "udp_srv_ip" value ="" />
            <param name = "udp_port" value ="5050" />
            <param name = "udp_stream_enable" value = "False" />
    </node>

</launch>

