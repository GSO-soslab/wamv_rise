<?xml version="1.0"?>

<robot name="wamv_rise">

    <link name="base_link">
    </link>

    <link name="cg_link"/>
    <joint name="cg_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="3.1415926 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="cg_link"/>
    </joint>

    <link name="nose_tip_link"/>
    <joint name="nose_tip_joint" type="fixed">
        <origin xyz="1.11 0.0 0.16" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="nose_tip_link"/>
    </joint>

    <link name="imu"/>
    <joint name="imu_joint" type="fixed">
        <origin xyz="0.15 -0.06 0.05" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="imu"/>
    </joint>

    <link name="imu_sf"/>
    <joint name="imu_sf_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="imu_sf"/>
    </joint>

    <link name="unicore_gps"/>
    <joint name="unicore_gps_joint" type="fixed">
        <origin xyz="-0.47 0.0 0.105" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="unicore_gps"/>
    </joint>

    <link name="nortek_dvl"/>
    <joint name="dvl_joint" type="fixed">
        <origin xyz="-1.4352 0.0375 -0.909" rpy="3.1415926 0.0 -1.5707963"/>
        <parent link="nose_tip_link"/>
        <child link="nortek_dvl"/>
    </joint>

    <link name="nortek_dvl_pressure"/>
    <joint name="dvl_joint_pressure" type="fixed">
        <origin xyz="-1.4352 0.0375 -0.909" rpy="0.0 0.0 -1.5707963"/>
        <parent link="nose_tip_link"/>
        <child link="nortek_dvl_pressure"/>
    </joint>

    <link name="airmar_link"/>
    <joint name="airmar_joint" type="fixed">
        <origin xyz="-1.4352 0.16 1.0" rpy="0.0 0.0 0.0"/>
        <parent link="nose_tip_link"/>
        <child link="airmar_link"/>
    </joint>

    <link name="usb_gps"/>
    <joint name="usb_gps_joint" type="fixed">
        <origin xyz="-1.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="nose_tip_link"/>
        <child link="usb_gps"/>
    </joint>    

    <link name="dvl_sf"/>
    <joint name="dvl_sf_joint" type="fixed">
        <origin xyz="-1.4352 0.0375 -0.909" rpy="0.0 0.0 0.0"/>
        <parent link="nose_tip_link"/>
        <child link="dvl_sf"/>
    </joint>

    <!-- <link name="pressure"/>
    <joint name="pressure_joint" type="fixed">
        <origin xyz="0.3 0.0 0.05" rpy="3.1415926 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="pressure"/>
    </joint> -->

    <!-- perception sensors -->

    <link name="velodyne"/>
    <joint name="velodyne_joint" type="fixed">
        <origin xyz="-0.35 -0.015 0.05" rpy="0.0 0.0 -0.017453"/>
        <parent link="nose_tip_link"/>
        <child link="velodyne"/>
    </joint>

    <link name="livox_frame"/>
    <joint name="livox_joint" type="fixed">
        <origin xyz="0.15 0.01 0.0" rpy="0.0 0.0 -1.554247"/>
        <parent link="velodyne"/>
        <child link="livox_frame"/>
    </joint>


    <link name="norbit"/>
    <joint name="norbit_joint" type="fixed">
        <origin xyz="-1.21435 -0.096718 -0.909" rpy="2.61 0.0 0.0"/>
        <parent link="nose_tip_link"/>
        <child link="norbit"/>
    </joint>

    <link name="usbl"/>
    <joint name="usbl_joint" type="fixed">
        <origin xyz="-1.21435 -0.096718 -1.0" rpy="0.0 0.0 -0.349065844"/>
        <parent link="nose_tip_link"/>
        <child link="usbl"/>
    </joint>    

    <link name="port_thruster_link"/>
    <joint name="port_thruster_joint" type="fixed">
        <origin xyz="-0.77 0.5 -0.1" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="port_thruster_link"/>
    </joint>       

    <link name="starboard_thruster_link"/>
    <joint name="starboard_thruster_joint" type="fixed">
        <origin xyz="-0.77 -0.5 -0.1" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="starboard_thruster_link"/>
    </joint> 

    <!-- sf sim sensors -->

    <!-- <link name="imu_sf"/>
    <joint name="imu__sf_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="imu"/>
        <child link="imu_sf"/>
    </joint> -->

