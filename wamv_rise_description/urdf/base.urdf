    <joint name="dvl_sf_joint" type="fixed">
        <origin xyz="0.51 0.0 -0.1" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="dvl_sf"/>
    </joint> -->

</robot>